# Copia este archivo como api/.env y pega las cadenas de conexión de Neon.
# Rama dev: para correr la API en tu computadora.
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require
# Rama test: las pruebas la borran y la vuelven a llenar.
TEST_DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require
